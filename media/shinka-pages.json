    "css": ".tl{margin:8px 0 28px}.sd-tool{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:16px}.tl2{display:block;font-size:14px;font-weight:800;margin:0 0 6px}.pair{display:grid;grid-template-columns:1fr;gap:6px}.pair .x{display:none}.pair select{width:100%;min-height:48px;font-size:17px;padding:0 12px;border:1px solid var(--muted);border-radius:6px;background:var(--bg);color:var(--text);margin-bottom:8px}.pkh{margin-top:8px}.pks{display:flex;flex-wrap:wrap;gap:8px}.pk{min-height:48px;padding:0 12px;font-size:14px;border:1px solid var(--muted);border-radius:6px;background:var(--bg);color:var(--text);cursor:pointer}.pk:focus-visible,.pair select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.out{border:1px solid var(--accent);border-radius:8px;padding:18px 16px;margin-top:14px;background:var(--card)}.o1{font-size:20px;font-weight:800;line-height:1.5}.o2{font-size:13px;color:var(--muted);margin:4px 0 12px}.bar{height:10px;border:1px solid var(--border);border-radius:4px;overflow:hidden;background:var(--bg)}.bar i{display:block;height:100%;background:var(--accent);margin-left:auto}.bl{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin:4px 0 12px}.ol div{display:grid;grid-template-columns:1fr;gap:2px;padding:8px 0;border-top:1px solid var(--border)}.ol dt{font-size:12px;color:var(--muted)}.ol dd{font-size:15px}.src li{font-size:12px;color:var(--muted);margin:8px 0 8px 18px;line-height:1.7}.src a{word-break:break-all}@media(min-width:600px){.pair{grid-template-columns:1fr auto 1fr;align-items:end}.pair .x{display:block;padding-bottom:20px}.ol div{grid-template-columns:11em 1fr}}",
    "head": "<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@graph\": [{\"@type\": \"WebApplication\", \"name\": \"あなたと〇〇は何年前に分かれた？\", \"url\": \"https://shinka.seadice.win/split/\", \"applicationCategory\": \"EducationalApplication\", \"operatingSystem\": \"Any\", \"browserRequirements\": \"JavaScript\", \"isAccessibleForFree\": true, \"inLanguage\": \"ja\", \"offers\": {\"@type\": \"Offer\", \"price\": \"0\", \"priceCurrency\": \"JPY\"}, \"description\": \"2つの生き物を選ぶと、共通の祖先から分かれたのが何年前かを、論文の推定を集めたTimeTreeの値で出す無料ツール。地球の歴史を1年にした日付と、そのころの地質時代も出す。\", \"citation\": \"https://doi.org/10.1093/molbev/msac174\", \"publisher\": {\"@type\": \"Organization\", \"@id\": \"https://seadice.win/#organization\", \"name\": \"SEADICE\", \"url\": \"https://seadice.win/\"}}]}</script>"
